# Copia este archivo a .env para probar en tu computadora. Nunca subas el .env al repositorio.
DATABASE_URL=postgresql://postgres@localhost:5432/growvia_datos
JWT_SECRETO=
# Correos que siempre son administradores (separados por coma)
ADMIN_INICIAL=jmedrano@corevia.global

# Correo (mismo SMTP que el CRM). Vacío = el código aparece en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=Growvia Datos <no-responder@growvia.global>

# apiconsulta.dev. Para probar sin gastar: uvicorn tests.mock_apiconsulta:app --port 4010
APICONSULTA_URL=http://localhost:4010
APICONSULTA_TOKEN=prueba-local
# Consultas del plan al mes (gratis 100, Plus 100000)
APICONSULTA_LIMITE_MES=100

# Copia del padrón de SUNAT en Azure (opcional)
AZURE_STORAGE_CONNECTION_STRING=
